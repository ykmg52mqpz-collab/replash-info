# Replash — üretim ortam değişkenleri
# setup.sh bunu otomatik üretir (.env.production); bu dosya referanstır.

NODE_ENV=production
PORT=3000

# Stream token imzalama anahtarı (setup.sh rastgele üretir)
REPLASH_SECRET=change-me

# Müjdat webhook imza anahtarı — Müjdat'a verilecek (setup.sh üretir)
REPLASH_WEBHOOK_SECRET=whsec_change-me

# Maç bitiminden izlenebilir olana kadarki işlenme süresi (dakika).
# Müjdat webhook'u zaten "hazır olunca" geldiği için provider akışında ek bekleme yoktur.
PROCESSING_MINUTES=10

# --- Video dosyaları Replash'te tutulacaksa (Mod B) AB object storage ---
# STORAGE=s3
# S3_ENDPOINT=https://s3.eu-south-1.amazonaws.com   # veya Scaleway/OVH/R2
# S3_REGION=eu-south-1
# S3_BUCKET=replash-media
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_FORCE_PATH_STYLE=false   # R2/Scaleway/MinIO için true

# --- İletişim formu (mevcut Formspree entegrasyonu) ---
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
